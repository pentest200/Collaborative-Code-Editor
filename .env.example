# Copy to .env and register a GitHub.com OAuth App with callback:
# http://localhost:3000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Shared only by Go and the private collaboration service. Replace outside local development.
COLLAB_INTERNAL_TOKEN=cce_dev_internal_only
# Local private MinIO. Replace these development fixtures outside local Compose.
MINIO_ROOT_USER=cce_local_storage
MINIO_ROOT_PASSWORD=cce_local_storage_only
# Optional explicit private-demo runner override; never browser/user-runtime credentials.
RUNNER_INTERNAL_TOKEN=
# Prebuild services/runner/{Python,Javascript}.Dockerfile and use docker image inspect .Id.
RUNNER_PYTHON_IMAGE=
RUNNER_JAVASCRIPT_IMAGE=
# Optional private development workspace settings are generated in .env.demo.local
# by scripts/start-workspaces.ps1. Production workspace execution is rejected.
# WORKSPACE_INTERNAL_TOKEN=
# WORKSPACE_IMAGE=sha256:...
# WORKSPACE_IDLE_TIMEOUT=15m
