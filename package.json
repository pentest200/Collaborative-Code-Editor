{
  "name": "collaborative-code-editor",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/web",
    "services/collab",
    "packages/protocol"
  ],
  "engines": {
    "node": ">=22.15 <27"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "check:contracts": "node scripts/check-contracts.mjs",
    "test:workspace": "node --test tests/e2e/workspace.test.mjs",
    "test:workbench": "node --test tests/e2e/workbench.test.mjs",
    "test:file-assets": "node --test tests/integration/file-assets.test.mjs",
    "test:realtime": "node --test tests/e2e/realtime.test.mjs",
    "test:recovery": "node --test tests/e2e/recovery.test.mjs",
    "test:checkpoints": "node --test tests/e2e/checkpoints.test.mjs",
    "test:execution": "node --test tests/integration/execution.test.mjs",
    "test:runs": "node --test tests/e2e/runs.test.mjs",
    "test:search": "node --test tests/e2e/search.test.mjs",
    "dev:web": "npm run dev -w @cce/web",
    "dev:collab": "npm run dev -w @cce/collab",
    "test:load": "node tests/load/workload.mjs",
    "test:observability": "node --test tests/integration/observability.test.mjs",
    "test:measurements": "node --test tests/e2e/measurements.test.mjs",
    "test:failure-demo": "node tests/load/failure-demo.mjs",
    "test:backup": "node --test tests/integration/backup.test.mjs",
    "test:jobs-death": "node --test tests/integration/jobs-death.test.mjs",
    "test:dashboard": "node --test tests/e2e/observability-dashboard.test.mjs",
    "test:runner-measurements": "node --test tests/integration/runner-measurements.test.mjs",
    "test:oauth-live": "node tests/e2e/live-oauth.mjs"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "playwright-core": "1.63.0",
    "yaml": "2.9.1"
  }
}
